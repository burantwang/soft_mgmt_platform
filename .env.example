# ============================================================
# 环境变量清单（复制为 .env 后填写，禁止提交真实值到代码仓库）
# ============================================================

# MySQL root 密码（mysql 容器初始化与 backend 连接共用）
MYSQL_ROOT_PASSWORD=ChangeMe_Strong_Password

# Jenkins 推送接口鉴权 Token（后端 /api/open/** 校验）
API_PUSH_TOKEN=ChangeMe_ApiPush_Token

# 初始超管 admin 密码（明文仅此处配置，入库为 BCrypt 密文；首次登录强制修改）
ADMIN_INIT_PASSWORD=ChangeMe_Admin_Init_Password
